# Groq key can also be supplied as GROQ_API_KEY.
SUSPICION_LLM_API_KEY=
SUSPICION_LLM_BASE_URL=https://api.groq.com/openai/v1
SUSPICION_LLM_MODEL=qwen/qwen3.8-27b

# From @BotFather. Empty = HTTP API only, no Telegram polling.
SUSPICION_TELEGRAM_TOKEN=
SUSPICION_BOT_HANDLE=@suspicion_check_bot

SUSPICION_DB_PATH=suspicion.db
# Change this in production.
SUSPICION_HASH_SALT=change-me
